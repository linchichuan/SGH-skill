# Public URL of this MCP resource server. Do not include a trailing slash.
MCP_PUBLIC_URL=https://mcp.shingihou.com

# OAuth 2.1 / OIDC authorization server. It must support authorization code
# with PKCE and bind access tokens to MCP_PUBLIC_URL as the audience/resource.
OAUTH_ISSUER=https://auth.example.com
OAUTH_AUDIENCE=https://mcp.shingihou.com
OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# Private SGH Service control-plane endpoint and internal credential.
# Never commit the real key.
SGH_SERVICE_API_BASE_URL=https://service-api.example.com/api/service/mcp
SGH_SERVICE_INTERNAL_API_KEY=replace-with-secret-manager-reference

# Comma-separated browser origins allowed to call /mcp. Non-browser MCP
# clients often omit Origin and are accepted when OAuth is valid.
MCP_ALLOWED_ORIGINS=https://chatgpt.com

PORT=3000
NODE_ENV=production
